generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id
  email        String   @unique
  displayName  String   @map("display_name")
  platformRole String   @default("user") @map("platform_role")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  sessions    Session[]
  memberships EventMembership[]
  teamMembers TeamMember[]
  scores      Score[]
  judgeScopes JudgeScope[]

  @@map("users")
}

model Session {
  id        String    @id
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Event {
  id               String   @id
  slug             String   @unique
  name             String
  submissionsClose DateTime @map("submissions_close") @db.Timestamptz(6)
  state            String   @default("published")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tracks      Track[]
  memberships EventMembership[]
  teams       Team[]
  projects    Project[]
  scores      Score[]
  judgeScopes JudgeScope[]

  @@map("events")
}

model Track {
  id      String @id
  eventId String @map("event_id")
  name    String

  event    Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  projects Project[]

  @@index([eventId])
  @@map("tracks")
}

model EventMembership {
  id      String @id
  eventId String @map("event_id")
  userId  String @map("user_id")
  role    String

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId, role])
  @@map("event_memberships")
}

model JudgeScope {
  id      String @id
  eventId String @map("event_id")
  userId  String @map("user_id")
  trackId String @map("track_id")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId, trackId])
  @@map("judge_scopes")
}

model Team {
  id      String @id
  eventId String @map("event_id")
  name    String

  event    Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  members  TeamMember[]
  projects Project[]

  @@index([eventId])
  @@map("teams")
}

model TeamMember {
  id     String @id
  teamId String @map("team_id")
  userId String @map("user_id")
  role   String @default("member")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@map("team_members")
}

model Project {
  id          String   @id
  eventId     String   @map("event_id")
  teamId      String   @map("team_id")
  trackId     String   @map("track_id")
  title       String
  summary     String?
  repoUrl     String?  @map("repo_url")
  submittedAt DateTime @map("submitted_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  event  Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  team   Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  track  Track   @relation(fields: [trackId], references: [id], onDelete: Cascade)
  scores Score[]

  @@index([eventId])
  @@index([trackId])
  @@map("projects")
}

model Score {
  id            String   @id
  eventId       String   @map("event_id")
  judgeUserId   String   @map("judge_user_id")
  projectId     String   @map("project_id")
  functionality Int
  quality       Int
  innovation    Int
  comment       String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  judge   User    @relation(fields: [judgeUserId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([judgeUserId, projectId])
  @@index([projectId])
  @@map("scores")
}