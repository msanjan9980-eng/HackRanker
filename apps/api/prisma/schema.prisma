generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GlobalRole { USER ADMIN }
enum EventStatus { DRAFT PUBLISHED ARCHIVED }
enum TeamRole { OWNER MEMBER }
enum TeamStatus { ACTIVE DISBANDED }
enum InviteStatus { PENDING ACCEPTED REVOKED EXPIRED }

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @unique
  emailVerifiedAt DateTime?
  passwordHash    String
  displayName     String
  globalRole      GlobalRole @default(USER)
  disabledAt      DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  sessions      Session[]
  memberships   TeamMember[]
  invitesSent   TeamInvite[] @relation("InviteCreatedBy")
  invitesUsed   TeamInvite[] @relation("InviteAcceptedBy")
  eventsCreated Event[]      @relation("EventCreatedBy")
  auditEntries  AuditLog[]

  @@index([globalRole])
}

model Session {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshHash  String    @unique
  familyId     String    @db.Uuid
  userAgent    String?
  ip           String?
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @db.Uuid
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

model Event {
  id          String      @id @default(uuid()) @db.Uuid
  slug        String      @unique
  name        String
  status      EventStatus @default(DRAFT)
  timezone    String      @default("UTC")
  startsAt    DateTime?
  endsAt      DateTime?
  createdById String?     @db.Uuid
  createdBy   User?       @relation("EventCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  tracks Track[]
  teams  Team[]

  @@index([status])
}

model Track {
  id        String   @id @default(uuid()) @db.Uuid
  eventId   String   @db.Uuid
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  slug      String
  name      String
  capacity  Int?
  createdAt DateTime @default(now())

  teams Team[]

  @@unique([eventId, slug])
}

model Team {
  id         String     @id @default(uuid()) @db.Uuid
  eventId    String     @db.Uuid
  event      Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  trackId    String?    @db.Uuid
  track      Track?     @relation(fields: [trackId], references: [id], onDelete: SetNull)
  name       String
  slug       String
  status     TeamStatus @default(ACTIVE)
  maxMembers Int        @default(4)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  members TeamMember[]
  invites TeamInvite[]

  @@unique([eventId, slug])
  @@index([eventId, status])
  @@index([trackId])
}

model TeamMember {
  id       String   @id @default(uuid()) @db.Uuid
  teamId   String   @db.Uuid
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId   String   @db.Uuid
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId  String   @db.Uuid
  role     TeamRole @default(MEMBER)
  joinedAt DateTime @default(now())

  @@unique([teamId, userId])
  @@unique([userId, eventId])
  @@index([teamId])
  @@index([userId])
}

model TeamInvite {
  id           String       @id @default(uuid()) @db.Uuid
  teamId       String       @db.Uuid
  team         Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  email        String
  role         TeamRole     @default(MEMBER)
  tokenHash    String       @unique
  status       InviteStatus @default(PENDING)
  expiresAt    DateTime
  acceptedAt   DateTime?
  acceptedById String?      @db.Uuid
  acceptedBy   User?        @relation("InviteAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)
  createdById  String       @db.Uuid
  createdBy    User         @relation("InviteCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt    DateTime     @default(now())

  @@index([teamId, status])
  @@index([email])
  @@index([expiresAt, status])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorIp    String?
  action     String
  targetType String
  targetId   String?
  eventId    String?  @db.Uuid
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([actorId, createdAt])
  @@index([eventId, createdAt])
  @@index([action, createdAt])
}
